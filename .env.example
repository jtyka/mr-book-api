DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/mr_book?sslmode=require"
# Erlaubte Web-Origins (kommagetrennt): zugleich CORS- und CSRF-Allowlist.
# POST/PUT/PATCH/DELETE ohne passenden Origin werden mit 403 abgelehnt.
WEB_ORIGINS="http://localhost:3001"

# Nur setzen, wenn die API hinter einem vertrauenswürdigen Proxy läuft, der
# x-forwarded-for selbst setzt (z. B. Vercel). Sonst wäre das IP-Rate-Limit
# per gefälschtem Header umgehbar.
TRUST_PROXY_HEADERS="false"

# Login nur mit bestätigter E-Mail erlauben (setzt echten Mailversand voraus).
REQUIRE_EMAIL_VERIFICATION="false"

# API-Key für den Mailversand über Resend (https://resend.com). Ohne diesen
# Key wird der Bestätigungslink nur in die Server-Logs geschrieben. Wenn der
# Key gesetzt ist, muss auch MAIL_FROM gesetzt sein.
RESEND_API_KEY=""

# Absenderadresse für Verifizierungs-Mails, z. B. "mr-book <noreply@jtyka.de>".
# Die Domain muss vorher bei Resend verifiziert sein, sonst schlägt der Versand fehl.
MAIL_FROM=""

# Passwort zurücksetzen: Ohne Mailversand (kein RESEND_API_KEY) wird der Link
# nur in Nicht-Production-Builds ins Log geschrieben. Auf Staging mit "true"
# freischalten, um Links aus den Logs zu holen. In Production nie setzen.
LOG_RESET_LINKS=

# SameSite-Attribut des Session-Cookies: "lax" (Standard) oder "none" (nur für
# Stage mit anderer Site als das Web; erzwingt Secure). Ungültige Werte -> lax.
# "none" wird in Vercel-Prod (VERCEL_ENV=production) ignoriert.
SESSION_COOKIE_SAMESITE="lax"

# Optionaler Key für die Google Books API (ISBN-Lookup). Ohne ihn fragt der
# Lookup nur Open Library ab. In der Google Cloud Console anlegen und auf die
# Books API beschränken.
GOOGLE_BOOKS_API_KEY=""

# Token des Vercel-Blob-Stores für Cover-Bilder. In Vercel sind der Production-
# und der Preview-Store mit dem Projekt verbunden (Variable wird dort gesetzt).
# Lokal das Token des Staging-Stores eintragen. Ohne Token antworten die
# Cover-Endpunkte mit 503 ("Der Bildspeicher ist nicht eingerichtet.").
BLOB_READ_WRITE_TOKEN=""
