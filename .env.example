DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/mr_book?sslmode=require"
WEB_ORIGINS="http://localhost:3001"

# Nur setzen, wenn die API hinter einem vertrauenswürdigen Proxy läuft, der
# x-forwarded-for selbst setzt (z. B. Vercel). Sonst wäre das IP-Rate-Limit
# per gefälschtem Header umgehbar.
TRUST_PROXY_HEADERS="false"

# Login nur mit bestätigter E-Mail erlauben (setzt echten Mailversand voraus).
REQUIRE_EMAIL_VERIFICATION="false"

# API-Key für den Mailversand über Resend (https://resend.com). Ohne diesen
# Key wird der Bestätigungslink nur in die Server-Logs geschrieben. Wenn der
# Key gesetzt ist, muss auch MAIL_FROM gesetzt sein.
RESEND_API_KEY=""

# Absenderadresse für Verifizierungs-Mails, z. B. "mr-book <noreply@jtyka.de>".
# Die Domain muss vorher bei Resend verifiziert sein, sonst schlägt der Versand fehl.
MAIL_FROM=""
