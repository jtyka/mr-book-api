generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Publisher {
  id      Int     @id @default(autoincrement())
  name    String
  country String?
  website String?
  address String?
  books   Book[]

  @@map("publishers")
}

model Author {
  id          Int       @id @default(autoincrement())
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  birthDate   DateTime? @map("birth_date") @db.Date
  nationality String?
  email       String?
  website     String?
  books       Book[]    @relation("BookAuthors")

  @@map("authors")
}

model Book {
  id             Int             @id @default(autoincrement())
  title          String
  isbn           String?
  pageCount      Int?            @map("page_count")
  publishedYear  Int?            @map("published_year")
  language       String?
  description    String?
  rating         Int?
  review         String?
  publisherId    Int?            @map("publisher_id")
  publisher      Publisher?      @relation(fields: [publisherId], references: [id])
  categories     Category[]      @relation("BookCategories")
  authors        Author[]        @relation("BookAuthors")
  readingHistory ReadingRecord[]

  @@map("books")
}

// Wie genau ein Datum bekannt ist: nur Jahr, Monat+Jahr oder tagesgenau.
// Unbekannte Teile werden im Datum mit 01 aufgefüllt (z. B. 2024-01-01 bei YEAR).
enum DatePrecision {
  DAY
  MONTH
  YEAR
}

model ReadingRecord {
  id                 Int            @id @default(autoincrement())
  bookId             Int            @map("book_id")
  startedAt          DateTime?      @map("started_at") @db.Date
  startedAtPrecision DatePrecision? @map("started_at_precision")
  readAt             DateTime?      @map("read_at") @db.Date
  readAtPrecision    DatePrecision? @map("read_at_precision")
  book               Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("reading_records")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  books    Book[]     @relation("BookCategories")

  @@map("categories")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}
