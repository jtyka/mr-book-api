generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Publisher {
  id      Int     @id @default(autoincrement())
  name    String
  country String?
  website String?
  books   Book[]

  @@map("publishers")
}

model Author {
  id          Int       @id @default(autoincrement())
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  birthDate   DateTime? @map("birth_date") @db.Date
  nationality String?
  books       Book[]    @relation("BookAuthors")

  @@map("authors")
}

model Book {
  id             Int             @id @default(autoincrement())
  title          String
  isbn           String?
  pageCount      Int?            @map("page_count")
  publishedYear  Int?            @map("published_year")
  language       String?
  description    String?
  rating         Int?
  review         String?
  publisherId    Int?            @map("publisher_id")
  categoryId     Int?            @map("category_id")
  publisher      Publisher?      @relation(fields: [publisherId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  authors        Author[]        @relation("BookAuthors")
  readingHistory ReadingRecord[]

  @@map("books")
}

model ReadingRecord {
  id        Int       @id @default(autoincrement())
  bookId    Int       @map("book_id")
  startedAt DateTime? @map("started_at") @db.Date
  readAt    DateTime? @map("read_at") @db.Date
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("reading_records")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  books    Book[]

  @@map("categories")
}
